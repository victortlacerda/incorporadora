  "description": "Plataforma de apresentação 3D e CRM de vendas para incorporadoras (maquete navegável, sol real, tour virtual, espelho de vendas, relatórios).",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/pos-build.mjs",
